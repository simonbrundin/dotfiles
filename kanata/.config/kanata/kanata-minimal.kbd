;; === MINIMAL TEST CONFIG - test med longer tap-hold times ===

(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  hold-down-key-cancels-pop-tap-drag yes
)

(defvar
  tap-time 300
  hold-time 300
)

(defalias
  ;; LAlt: tap = radera ord, hold = normal LAlt
  lalt-del (tap-hold $tap-time $hold-time C-bspc lalt)
)

(defsrc
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft
         lctl  lmet  lalt                spc              ralt  rctl  rmet
)

(deflayer base
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft
         lctl  lmet  @lalt-del            spc              ralt  rctl  rmet
)
